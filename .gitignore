*.nupkg
*.dll
*.pdb
*.dylib
*.so
*.zip

# deps working dirs (vcpkg build output + fetched prebuilt archives).
# Only the per-component vcpkg manifests are tracked; everything else under deps/ is generated.
/deps/*
!/deps/openssl
!/deps/libssh2
/deps/openssl/*
/deps/libssh2/*
!/deps/openssl/vcpkg.json
!/deps/libssh2/vcpkg.json
